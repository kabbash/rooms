# Copy to .env (cp .env.example .env). Values below match docker-compose.yml.

# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://rooms:rooms@localhost:5433/rooms?schema=public"

# Link back to the main portal (header "RC Portal" link)
PORTAL_URL="https://portal.remotecoders.org"

# All times are stored in UTC and shown in this zone
OFFICE_TIMEZONE="Africa/Cairo"
